# LaTeX temp files
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.bcf
*.blg
*.run.xml

# Generated PDFs
*.pdf

# Python generator/script files for experiments
gen_*.py
test_*.py
refactor_*.py

# Test/Sandbox LaTeX files
test_*.tex
edits.tex

# Web App / Node
web/node_modules/
web/.svelte-kit/
web/build/

# Intermediate pipeline output (re-generated by build_web_data.py)
web_data/

# Language Caches
__pycache__/
*.pyc

# Explicitly track final Web PDF asset
!web/static/*.pdf
