  "boxes": [
    {
      "type": "anchorbox",
      "title": "Focus Under Pressure",
      "description": "He carried the absolute weight of a massive responsibility (Rama's signet ring) across a terrifying, treacherous ocean without dropping it. Taking on great responsibility in education or life requires unshakeable focus and the determination not to let distractions sink your goals.",
