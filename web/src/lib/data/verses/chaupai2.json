  "boxes": [
    {
      "type": "anchorbox",
      "title": "Functional Leadership",
      "description": "True leadership is about capability and trust, not titles. When millions of soldiers were dispatched to find Sita, Prince Angada was the official commander of the party, yet Lord Rama handed his personal signet ring to Hanuman alone. Rama recognized Hanuman as the functional leader whose competence, intellect, and empathy would guide the team to success.",
      "motivating_text": "",
      "citation": ""
    },
    {
      "type": "gotchabox",
      "items": [
        "Conjunct Consonant Weight (पुत्र): The short 'u' in पु gets weighed down and becomes a 2-beat Guru because it crashes into the conjunct consonant त्र (t+ra)."
      ]
    }
  ]
