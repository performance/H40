  "boxes": [
    {
      "type": "anchorbox",
      "title": "The Ultimate Reliable Executive",
      "description": "He is called the ultimate Messenger (Rama Duta). When millions of soldiers were dispatched to find Sita, Lord Rama handed his personal signet ring to Hanuman alone. Leadership means identifying and encouraging people to be the best they can be and capable of taking on hard challenges. Hanuman inspires us to be our best by example, as he was relied upon to execute the hardest mission of reaching Lanka and finding Sita.",
      "motivating_text": "",
      "citation": ""
    },
    {
      "type": "gotchabox",
      "items": [
        "Conjunct Consonant Weight (पुत्र): The short 'u' in पु gets weighed down and becomes a 2-beat Guru because it crashes into the conjunct consonant त्र (t+ra)."
      ]
    }
  ]
