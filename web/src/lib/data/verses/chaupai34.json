  "boxes": [
    {
      "type": "anchorbox",
      "title": "The Ultimate Destination",
      "description": "By dedicating our lives to service and excellence, our legacy (Anta Kaal) becomes immortal. In the *Valmiki Ramayana* (*Yuddha Kanda, 1:13*), Lord Rama laments that Hanuman's monumental, selfless service is so vast that no material reward could ever match it. Rama offers his own embrace as his entire wealth, establishing Hanuman's eternal spiritual legacy.",
      "motivating_text": "",
      "citation": ""
    }
  ]
