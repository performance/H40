  "boxes": [
    {
      "type": "anchorbox",
      "title": "Converting Constraints to Opportunities",
      "description": "In the *Valmiki Ramayana* (*Sundara Kanda, 48:45-50*), when bound by Indrajit's weapon, Hanuman intentionally chose not to break free immediately. He realized that being bound allowed him to be taken directly to Ravana's court, giving him the perfect opportunity to meet the enemy king face-to-face and deliver a message of peace and warning. It teaches us to convert constraints into opportunities.",
      "motivating_text": "",
      "citation": ""
    }
  ]
