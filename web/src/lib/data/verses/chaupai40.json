  "boxes": [
    {
      "type": "anchorbox",
      "title": "Egoless Honor",
      "description": "True greatness and peace begin with a humble, egoless mind (Hriday Maha Dera). In the *Valmiki Ramayana* (*Yuddha Kanda, 128:81-83*), when Sita presents Hanuman with the highest honor of a divine pearl necklace, Hanuman accepts it with absolute humility and devotion, demonstrating that he values the love and grace of the divine far more than any material decoration.",
      "motivating_text": "",
      "citation": ""
    }
  ]
