  "boxes": [
    {
      "type": "anchorbox",
      "title": "The Crisis Preventer (Strategic Leadership)",
      "description": "Before returning to Ayodhya, Lord Rama sent Hanuman ahead to meet Bharata and gauge his true feelings. If Bharata had grown accustomed to power, Rama's sudden return could cause a political crisis or emotional distress. Hanuman acted with supreme diplomacy, emotional intelligence, and leadership, ensuring a seamless, joyful transition of power and preventing any potential crisis.",
      "motivating_text": "",
      "citation": ""
    }
  ]
